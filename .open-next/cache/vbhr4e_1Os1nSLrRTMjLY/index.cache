a una oportunidad para descubrir nuevos lugares, conocer personas y vivir momentos que quedarán grabados en la memoria.\"}]]}]}],[\"$\",\"ul\",null,{\"className\":\"collageImgs-list\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"collageImgs-list-item collageImgs-list-itemNumber1\",\"children\":[\"$\",\"$L19\",null,{\"animation\":\"down\",\"pixelsDisplacement\":120,\"duration\":1000,\"delay\":200,\"children\":[\"$\",\"img\",null,{\"src\":\"/img/imagenesInicio/imagenSobreNosotros1.webp\",\"alt\":\"Vista por Dron Rancho Roma\",\"className\":\"collageImgs-list-item-img\"}]}]}],[\"$\",\"li\",\"1\",{\"className\":\"collageImgs-list-item collageImgs-list-itemNumber2\",\"children\":\"$L1a\"}],\"$L1b\"]}]]}]}],\"$L1c\",\"$L1d\"]]}],[\"$L1e\",\"$L1f\",\"$L20\"],\"$L21\"]}]\nf:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L22\",null,{\"children\":\"$L23\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L24\",null,{\"children\":[\"$\",\"$25\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L26\"}]}]}],null]}]\n11:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0fxi_h-xzasxo.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n12:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1qe_p9pb_-6oa.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n13:[\"$\",\"link\",\"2\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/3piepmm47cc3f.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n27:I[10977,[\"/_next/static/chunks/1tg1nphpleoz2.js\",\"/_next/static/chunks/3mghlats8guxc.js\",\"/_next/static/chunks/3il1ltznctont.js\",\"/_next/static/chunks/0t6nnnwvkw_g9.js\",\"/_next/static/chunks/2dikeezmct3sb.js\"],\"default\"]\n28:I[27083,[\"/_next/static/chunks/1tg1nphpleoz2.js\",\"/_next/static/chunks/3mghlats8guxc.js\",\"/_next/static/chunks/3il1ltznctont.js\",\"/_next/static/chunks/0t6nnnwvkw_