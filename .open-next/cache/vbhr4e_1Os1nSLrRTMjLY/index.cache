der\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"bannerWithMessage-header-title\",\"children\":\"Conoce los lugares mágicos de Perú y disfruta de una experiencia única en la naturaleza, la cultura y la historia peruana.\"}],[\"$\",\"p\",null,{\"className\":\"bannerWithMessage-header-description\",\"children\":\"\"}]]}]}],\"\"]}],[\"$\",\"section\",\"7CollageImgs\",{\"className\":\"collageImgs \",\"id\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"collageImgs-container\",\"children\":[[\"$\",\"$L19\",null,{\"animation\":\"left\",\"pixelsDisplacement\":80,\"duration\":1000,\"delay\":0,\"children\":[\"$\",\"div\",null,{\"className\":\"collageImgs-text\",\"children\":[[\"$\",\"p\",null,{\"className\":\"collageImgs-text-subTitle\",\"children\":\"Travel Beyond the Ordinary\"}],[\"$\",\"h2\",null,{\"className\":\"collageImgs-text-title\",\"children\":[[\"$\",\"span\",null,{\"className\":\"collageImgs-text-title-highligh\",\"children\":\"\"}],\"PREMIUM EVENTS\"]}],[\"$\",\"div\",null,{\"className\":\"collageImgs-text-divider\",\"aria-hidden\":\"true\"}],[\"$\",\"p\",null,{\"className\":\"collageImgs-text-description\",\"children\":\"Diseñamos rutas pensadas para combinar cultura, naturaleza y descanso en un solo viaje, brindando experiencias únicas y memorables. Nuestro objetivo es que cada viaje sea una oportunidad para descubrir nuevos lugares, conocer personas y vivir momentos que quedarán grabados en la memoria.\"}]]}]}],[\"$\",\"ul\",null,{\"className\":\"collageImgs-list\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"collageImgs-list-item collageImgs-list-itemNumber1\",\"children\":[\"$\",\"$L19\",null,{\"animation\":\"down\",\"pixelsDisplacement\":120,\"duration\":1000,\"delay\":200,\"children\":[\"$\",\"img\",null,{\"src\":\"/img/imagenesInicio/imagenSobreNosotros1.webp\",\"alt\":\"Vista por Dron Rancho Roma\",\"className\":\"collageImgs-list-item-img\"}]}]}],[\"$\",\"li\",\"1\",{\"className\":\"collageImgs-list-item collageImgs-list